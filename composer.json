{
    "name": "ticoscope/laravel",
    "description": "A diff-based, Laravel-aware pre-deployment risk report. Experimental, pre-v0.1.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "release",
        "deployment",
        "static-analysis",
        "ci"
    ],
    "authors": [
        {
            "name": "Daniel",
            "email": "danielbrenesfz@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "TicoScope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TicoScope\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TicoScope\\TicoScopeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
